# Copy this file to .env.local and fill in real values. Never commit .env.local.
# On Vercel, add the same names under Project Settings > Environment Variables.

# Your course (Vocareum) or OpenAI API key. Server-side only.
OPENAI_API_KEY=

# OpenAI-compatible endpoint. For the AIM course proxy use the base URL shown in Vocareum's AI panel.
OPENAI_BASE_URL=https://openai.vocareum.com/v1

# Must support tool (function) calling.
OPENAI_MODEL=gpt-4o-mini
